# ==============================================
# DigiTwin — Environment Configuration
# ==============================================
# Copy to .env and adjust values as needed.
# Defaults are set for local development.

# --- Ollama (Local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b
# For lighter hardware, use: gemma4 (defaults to e4b, 9.6GB)
# For best quality: gemma4:31b (20GB)

# Ollama exposes an OpenAI-compatible API at /v1
# Our LLM client uses this, so the effective base URL is:
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma4:26b
LLM_API_KEY=ollama
# Ollama doesn't need a real API key, but the OpenAI client requires one

# --- Neo4j (Knowledge Graph) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=digitwin_dev

# --- Redis (Cache + Pub/Sub) ---
REDIS_URL=redis://localhost:6379/0

# --- ChromaDB (Vector Store) ---
CHROMA_PERSIST_DIR=./data/chroma

# --- File Storage ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# --- Server ---
HOST=0.0.0.0
PORT=5001
DEBUG=true
LOG_LEVEL=DEBUG

# --- Frontend ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
